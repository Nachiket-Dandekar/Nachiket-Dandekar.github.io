---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import { SITE } from '../site.config';
import { hasResume, url } from '../lib/utils';

// ---------------------------------------------------------------------------
// Edit the text on this page here. Lines that start with "TODO:" are highlighted
// on the page until you replace them.
// ---------------------------------------------------------------------------
const bio = [
  "I'm Nachiket Dandekar, and I go by Nacho. I'm from Austin, Texas, and I started electrical engineering at UTSA in fall 2026.",
  'I want to work in hardware: FPGAs, low-latency systems and chip design. In my tick-to-trade project I built the whole path from market data to order on an FPGA, measured it on the board, and found what limits it.',
  'TODO: two or three sentences on how you got into hardware and what you are looking for next, for example internships or research.',
];

const experience = [
  {
    org: 'NASA Johnson Space Center',
    role: 'Electrical engineering intern, SEV team',
    when: 'June to July 2026',
    points: [
      'TODO: what you worked on. Only include what you are cleared to share publicly.',
      'TODO: a result or number, if you can share one.',
    ],
  },
  {
    org: 'FRC Team 2468',
    role: 'Electrical co-lead in 2026. Team member from 2022 to 2025.',
    when: '2022 to 2026',
    points: ['TODO: what you led or built on the robot electrical system.', 'TODO: a result, for example a competition or a fix you made.'],
  },
];

const education = [
  {
    org: 'University of Texas at San Antonio (UTSA)',
    role: 'Electrical engineering',
    when: 'Started fall 2026',
    points: ['TODO: expected graduation year, and any relevant courses or clubs.'],
  },
];

// Every item here comes from a project on this site. TODO: check this list and add anything missing.
const skills = [
  { group: 'Digital design', items: ['Verilog', 'Xilinx Vivado', 'Artix-7 (Arty A7-100T)', 'Timing closure', 'Block RAM', 'Clock domain crossing'] },
  { group: 'Verification', items: ['cocotb', 'Icarus Verilog', 'Python reference models'] },
  { group: 'Interfaces', items: ['Ethernet MII', 'UDP', 'Nasdaq ITCH 5.0', 'MoldUDP64', 'UART'] },
  { group: 'Software and tools', items: ['Python', 'MATLAB', 'KiCad', 'Raspberry Pi'] },
];

const resume = hasResume();
const isTodo = (s: string) => s.startsWith('TODO');
---

<BaseLayout title="About" description={`About ${SITE.name}: experience, skills and resume.`}>
  <div class="wrap">
    <header class="head">
      <div>
        <p class="label">About</p>
        <h1>{SITE.name}</h1>
      </div>
      <ProfilePhoto size={120} class="about-photo" />
    </header>

    <section class="bio" aria-label="Bio">
      {bio.map((p) => <p class:list={{ todo: isTodo(p) }}>{p}</p>)}
      {
        resume ? (
          <p>
            <a class="resume" href={url(`/${SITE.resumeFile}`)} download>
              Download my resume (PDF)
            </a>
          </p>
        ) : (
          import.meta.env.DEV && <p class="todo mono-sm">TODO: add your resume as public/resume.pdf. The download link appears when the file exists.</p>
        )
      }
    </section>

    <section aria-labelledby="exp">
      <h2 id="exp" class="sec">Experience</h2>
      <ol class="timeline">
        {
          experience.map((e) => (
            <li>
              <div class="when mono-sm">{e.when}</div>
              <h3>{e.org}</h3>
              <p class="role">{e.role}</p>
              <ul>
                {e.points.map((pt) => (
                  <li class:list={{ todo: isTodo(pt) }}>{pt}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="edu">
      <h2 id="edu" class="sec">Education</h2>
      <ol class="timeline">
        {
          education.map((e) => (
            <li>
              <div class="when mono-sm">{e.when}</div>
              <h3>{e.org}</h3>
              <p class="role">{e.role}</p>
              <ul>
                {e.points.map((pt) => (
                  <li class:list={{ todo: isTodo(pt) }}>{pt}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="skills">
      <h2 id="skills" class="sec">Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>
                <ul>
                  {s.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 3.5rem 0 1.5rem;
  }
  h1 {
    font-size: 2.9rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-top: 0.5rem;
  }
  .bio p + p {
    margin-top: 1rem;
  }
  .bio p {
    max-width: 62ch;
  }
  .resume {
    display: inline-block;
    margin-top: 0.5rem;
    font: 500 0.9rem var(--font-mono);
    color: var(--link);
    border: 1px solid color-mix(in srgb, var(--link) 55%, transparent);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    text-decoration: none;
  }
  .resume:hover {
    background: color-mix(in srgb, var(--link) 15%, transparent);
  }
  .sec {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 3rem 0 1.25rem;
  }
  .timeline {
    list-style: none;
    padding: 0;
  }
  .timeline > li {
    position: relative;
    padding: 0 0 1.75rem 1.5rem;
    border-left: 2px solid var(--rule);
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.3rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--muted);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .timeline > li:last-child {
    padding-bottom: 0.25rem;
  }
  h3 {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 0.15rem;
  }
  .role {
    color: var(--muted);
  }
  .timeline ul {
    list-style: disc;
    padding-left: 1.2rem;
    margin-top: 0.5rem;
  }
  .timeline ul li + li {
    margin-top: 0.3rem;
  }
  .timeline ul li::marker {
    color: var(--muted);
  }
  .skills {
    display: grid;
    gap: 1rem;
  }
  .skills > div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  dt {
    font: 600 0.85rem var(--font-mono);
    color: var(--muted);
    padding-top: 0.2rem;
  }
  dd ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  dd li {
    font: 0.8rem var(--font-mono);
    border: 1px solid var(--rule);
    background: var(--soft);
    border-radius: 6px;
    padding: 0.15rem 0.55rem;
  }
  @media (max-width: 720px) {
    .head {
      padding-top: 2rem;
    }
    h1 {
      font-size: 2.1rem;
    }
    .head :global(.about-photo) {
      --size: 72px !important;
    }
    .skills > div {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
  :global([data-look='bold']) .resume {
    background: var(--link);
    border-color: var(--link);
    color: var(--bg);
  }
</style>
