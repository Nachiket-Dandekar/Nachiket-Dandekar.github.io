---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import { SITE } from '../site.config';
import { hasResume, url } from '../lib/utils';

// ---------------------------------------------------------------------------
// Edit the text on this page here. Lines that start with "TODO:" are highlighted
// on the page until you replace them.
// ---------------------------------------------------------------------------
const bio = [
  "I'm a first-year Electrical Engineering student at UTSA, from Austin, Texas.",
  "Before college I spent four years on FRC Team 2468's electrical subteam. I wired the robots, set up motor controllers, and debugged electrical problems in the shop and at competitions. I co-led the subteam my senior year.",
  "This summer I interned at NASA Johnson Space Center on the electrical team for the Space Exploration Vehicle. I restored the vehicle's battery packs after a cell failure took it offline, tracked down a CAN communication fault in the cabana mechanism, and moved the vehicle's wiring diagrams into KiCad.",
  "I'm most interested in FPGAs and low-latency hardware. My latest project is a tick-to-trade system on an Arty A7. It reads real Nasdaq market data over Ethernet and sends an order back in 130 ns. Next I'm designing my own FPGA board to get past the Arty's 100 Mb/s Ethernet limit.",
];

// From the resume. FRC roles follow what Nachiket said: member 2022 to 2025, co-lead in 2026.
const experience = [
  {
    org: 'NASA Johnson Space Center',
    role: 'Electrical engineering intern, Space Exploration Vehicle (SEV) team',
    when: 'June to July 2026',
    points: [
      "Restored the SEV's battery packs after a cell failure took the vehicle offline. I measured, balanced and replaced cells, reinstalled the packs, and brought the vehicle back online with the battery management system reporting.",
      'Diagnosed a CAN communication fault in the SEV cabana mechanism, which runs AMC DigiFlex drives on a 125 kbit/s CANopen bus. I connected to the drives over RS-232 with DriveWare, checked node IDs, baud rate, bus termination and wiring continuity, and narrowed the fault to the master controller board.',
      "Converted the SEV's draw.io wiring diagrams into KiCad schematics that follow the team drawing standard, organized in hierarchical sheets and tracked in git.",
      'Traced and documented the exterior lighting wiring before an upgrade, picked a flyback diode (6A10) for the inductive load, and wrote a one-page design note on the choice.',
    ],
  },
  {
    org: 'FRC Team 2468, Westlake High School',
    role: 'Electrical co-lead in 2026. Team member from 2022 to 2025.',
    when: '2022 to 2026',
    points: [
      'Worked on competition robot wiring, motor controller setup and board bring-up.',
      'Debugged robot electrical faults in the shop and at competitions with a multimeter and vendor diagnostic software.',
    ],
  },
];

const education = [
  {
    org: 'University of Texas at San Antonio (UTSA)',
    role: 'B.S. Electrical Engineering, expected May 2030',
    when: 'Started fall 2026',
    points: ['Coursework: Intro to Electrical Engineering with lab, Calculus II, Physics I with lab.'],
  },
];

// From the resume and the projects on this site.
const skills = [
  { group: 'Digital design', items: ['Verilog', 'Vivado', 'Artix-7 (Arty A7-100T)', 'Static timing analysis', 'Clock domain crossing', 'Block RAM'] },
  { group: 'Verification', items: ['cocotb', 'Icarus Verilog', 'Python reference models'] },
  { group: 'Hardware', items: ['KiCad (schematics, PCB layout)', 'Soldering', 'Multimeter debugging', 'Battery systems'] },
  { group: 'Interfaces', items: ['CAN / CANopen', 'RS-232', 'Ethernet / UDP', 'UART', 'Nasdaq ITCH 5.0'] },
  { group: 'Software', items: ['Python', 'C++', 'Java', 'MATLAB', 'Linux', 'git'] },
];

const resume = hasResume();
const isTodo = (s: string) => s.startsWith('TODO');
---

<BaseLayout title="About" description={`About ${SITE.name}: experience, skills and resume.`}>
  <div class="wrap">
    <header class="head">
      <div>
        <h1>{SITE.name}</h1>
      </div>
      <ProfilePhoto size={120} class="about-photo" />
    </header>

    <section class="bio" aria-label="Bio">
      {bio.map((p) => <p class:list={{ todo: isTodo(p) }}>{p}</p>)}
      <p>
        I'm looking for Summer 2027 internships in hardware, FPGA or embedded work. You can reach me by{' '}
        <a href={`mailto:${SITE.email}`}>email</a> or find me on <a href={SITE.linkedin}>LinkedIn</a> and{' '}
        <a href={SITE.github}>GitHub</a>.
      </p>
      {
        resume ? (
          <p>
            <a class="resume" href={url(`/${SITE.resumeFile}`)} download>
              Download my resume (PDF)
            </a>
          </p>
        ) : (
          import.meta.env.DEV && <p class="todo mono-sm">TODO: add your resume as public/resume.pdf. The download link appears when the file exists.</p>
        )
      }
    </section>

    <section aria-labelledby="exp">
      <h2 id="exp" class="sec">Experience</h2>
      <ol class="timeline">
        {
          experience.map((e) => (
            <li>
              <div class="when mono-sm">{e.when}</div>
              <h3>{e.org}</h3>
              <p class="role">{e.role}</p>
              <ul>
                {e.points.map((pt) => (
                  <li class:list={{ todo: isTodo(pt) }}>{pt}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="edu">
      <h2 id="edu" class="sec">Education</h2>
      <ol class="timeline">
        {
          education.map((e) => (
            <li>
              <div class="when mono-sm">{e.when}</div>
              <h3>{e.org}</h3>
              <p class="role">{e.role}</p>
              <ul>
                {e.points.map((pt) => (
                  <li class:list={{ todo: isTodo(pt) }}>{pt}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="skills">
      <h2 id="skills" class="sec">Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>
                <ul>
                  {s.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 3.5rem 0 1.5rem;
  }
  h1 {
    font-size: 2.9rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-top: 0.5rem;
  }
  .bio p + p {
    margin-top: 1rem;
  }
  .bio p {
    max-width: 62ch;
  }
  .resume {
    display: inline-block;
    margin-top: 0.5rem;
    font: 500 0.9rem var(--font-mono);
    color: var(--link);
    border: 1px solid color-mix(in srgb, var(--link) 55%, transparent);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    text-decoration: none;
  }
  .resume:hover {
    background: color-mix(in srgb, var(--link) 15%, transparent);
  }
  .sec {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 3rem 0 1.25rem;
  }
  .timeline {
    list-style: none;
    padding: 0;
  }
  .timeline > li {
    position: relative;
    padding: 0 0 1.75rem 1.5rem;
    border-left: 2px solid var(--rule);
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.3rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--muted);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .timeline > li:last-child {
    padding-bottom: 0.25rem;
  }
  h3 {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 0.15rem;
  }
  .role {
    color: var(--muted);
  }
  .timeline ul {
    list-style: disc;
    padding-left: 1.2rem;
    margin-top: 0.5rem;
  }
  .timeline ul li + li {
    margin-top: 0.3rem;
  }
  .timeline ul li::marker {
    color: var(--muted);
  }
  .skills {
    display: grid;
    gap: 1rem;
  }
  .skills > div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  dt {
    font: 600 0.85rem var(--font-mono);
    color: var(--muted);
    padding-top: 0.2rem;
  }
  dd ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  dd li {
    font: 0.8rem var(--font-mono);
    border: 1px solid var(--rule);
    background: var(--soft);
    border-radius: 6px;
    padding: 0.15rem 0.55rem;
  }
  @media (max-width: 720px) {
    .head {
      padding-top: 2rem;
    }
    h1 {
      font-size: 2.1rem;
    }
    .head :global(.about-photo) {
      --size: 72px !important;
    }
    .skills > div {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
