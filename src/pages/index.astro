---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import { SITE, topicVar } from '../site.config';
import { getProjects, hasResume, url } from '../lib/utils';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const shown = featured.length ? featured : projects.slice(0, 3);
const resume = hasResume();

const nowItems = await Promise.all(
  (await getCollection('now'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (item) => ({ item, Body: (await render(item)).Content })),
);
const href = (h: string) => (h.startsWith('/') ? url(h) : h);
---

<BaseLayout>
  <div class="wrap">
    <section class="hero" aria-labelledby="name">
      <div>
        <p class="kicker">Electrical engineering &middot; UTSA</p>
        <h1 id="name">{SITE.name}</h1>
        <p class="intro">
          I go by {SITE.nickname}. I'm an electrical engineering freshman at UTSA, and I want to work on FPGAs, low-latency
          systems and chip design. Below are the things I've built, with the numbers I measured.
        </p>
        <ul class="facts" aria-label="Highlights">
          <li>NASA JSC intern, SEV team, 2026</li>
          <li>FRC 2468 electrical co-lead, 2026</li>
          {
            resume && (
              <li class="link">
                <a href={url(`/${SITE.resumeFile}`)} download>
                  resume.pdf
                </a>
              </li>
            )
          }
        </ul>
      </div>
      <ProfilePhoto size={150} class="hero-photo" />
    </section>

    <section aria-labelledby="latest">
      <div class="section-head">
        <h2 id="latest" class="label">{shown.length > 1 ? 'Projects' : 'Latest project'}</h2>
        <a href={url('/projects/')} class="mono-sm all-link">All projects &rarr;</a>
      </div>
      <div class="list">
        {shown.map((p, i) => <ProjectRow project={p} priority={i === 0} />)}
        {shown.length === 0 && <p class="mono-sm py-6">No projects yet.</p>}
      </div>
    </section>

    {
      nowItems.length > 0 && (
        <section class="now" aria-labelledby="now">
          <div class="section-head">
            <h2 id="now" class="label">Working on now</h2>
          </div>
          <ul class="now-list">
            {nowItems.map(({ item, Body }) => (
              <li style={item.data.topic ? `--tc: ${topicVar(item.data.topic)}` : undefined}>
                <div class="now-head">
                  <h3>{item.data.title}</h3>
                  <span class="stage">{item.data.stage}</span>
                </div>
                <div class="now-body">
                  <Body />
                </div>
                {item.data.link && (
                  <a class="mono-sm now-link" href={href(item.data.link.href)}>
                    {item.data.link.label} &rarr;
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 4.5rem 0 3rem;
  }
  .kicker {
    font: 500 0.8125rem var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }
  h1 {
    font-size: 3.5rem;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .intro {
    max-width: 54ch;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    margin-top: 1.1rem;
  }
  .facts li {
    font: 0.78rem var(--font-mono);
    border: 1px solid var(--rule);
    background: var(--soft);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }
  .facts li.link {
    border-color: color-mix(in srgb, var(--link) 55%, transparent);
  }
  .facts li.link a {
    color: var(--link);
    text-decoration: none;
  }
  .facts li.link:hover {
    background: color-mix(in srgb, var(--link) 15%, transparent);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.6rem;
  }
  .list {
    border-top: 1px solid var(--ink);
  }
  .now {
    margin-top: 3.5rem;
  }
  .now-list {
    border-top: 1px solid var(--ink);
  }
  .now-list li {
    position: relative;
    padding: 1.2rem 0 1.2rem 1.4rem;
    border-bottom: 1px solid var(--rule);
  }
  /* Each dot takes the topic color of the item (see src/styles/global.css). */
  .now-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.65rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tc, var(--muted));
  }
  .now-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.9rem;
  }
  h3 {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .stage {
    font: 500 0.75rem var(--font-mono);
    color: var(--muted);
  }
  .now-body {
    color: var(--muted);
    margin-top: 0.3rem;
    max-width: 62ch;
  }
  .now-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--link);
    text-decoration: none;
  }
  .now-link:hover {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .hero {
      position: relative;
      display: block;
      padding: 1.75rem 0 1.75rem;
    }
    .kicker {
      padding-right: 4.5rem;
    }
    h1 {
      font-size: 2.3rem;
      padding-right: 4.5rem;
    }
    .hero :global(.hero-photo) {
      --size: 60px !important;
      position: absolute;
      right: 0;
      top: 1.75rem;
    }
    .facts li {
      font-size: 0.72rem;
    }
  }
</style>
