---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Tag from '../../../components/Tag.astro';
import YouTube from '../../../components/mdx/YouTube.astro';
import { mdxComponents } from '../../../components/mdx';
import { getProjects, formatDate, projectFileUrl, url } from '../../../lib/utils';

export async function getStaticPaths() {
  const projects = await getProjects();
  const logs = await getCollection('logs');
  const logIds = new Set(logs.map((l) => l.id));
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project, hasLog: logIds.has(project.id) },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  hasLog: boolean;
}
const { project, hasLog } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);

// Sections: 1 Summary, 2 Video, 3..n from the MDX body (## headings), then Links.
const bodySections = headings.filter((h) => h.depth === 2).length;
const linksNumber = 3 + bodySections;
const HUES = ['blue', 'red', 'yellow', 'green'];
const STAT_HUES = ['blue', 'yellow', 'green']; // no red: red means "bad" next to a result
const hue = (n: number) => HUES[(n + 2) % 4]; // 2 -> blue, 3 -> red, 4 -> yellow, ...

const isTodo = (s?: string) => !!s && /TODO/.test(s);
const downloads = d.downloads.map((f) => ({ ...f, href: projectFileUrl(project, f.file) })).filter((f) => f.href);
const missingDownloads = d.downloads.filter((f) => !projectFileUrl(project, f.file));
if (missingDownloads.length) {
  throw new Error(`${project.id}: download file not found in the project folder: ${missingDownloads.map((f) => f.file).join(', ')}`);
}
---

<BaseLayout title={d.title} description={d.summary} image={d.cover}>
  <article class="wrap">
    <a href={url('/projects/')} class="back mono-sm">&larr; All projects</a>
    <header class="head">
      <div class="meta">
        {d.tags.map((t) => <Tag tag={t} />)}
        <time class="mono-sm" datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
        {d.status && <span class="mono-sm">{d.status}</span>}
        {d.draft && <span class="draft">draft, hidden on the live site</span>}
      </div>
      <h1>{d.title}</h1>
    </header>

    <section class="summary" aria-labelledby="s-summary">
      <h2 id="s-summary" class="label"><span class="c-green">1</span> Summary</h2>
      <p class:list={['lede', { todo: isTodo(d.summary) }]}>{d.summary}</p>
      {
        d.stats.length > 0 && (
          <dl class="stats">
            {d.stats.map((s, i) => (
              <div>
                <dt class:list={{ todo: isTodo(s.label) }}>{s.label}</dt>
                <dd class:list={[`c-${STAT_HUES[i % 3]}`, { todo: isTodo(s.value) }]}>
                  {/^\d+(\.\d+)?$/.test(s.value) ? <span data-count={s.value}>{s.value}</span> : s.value}
                  {s.unit && <span class="unit">{s.unit}</span>}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
      {d.measured && <p class="measured mono-sm">{d.measured}</p>}
    </section>

    <section aria-labelledby="s-video">
      <h2 id="s-video" class="sec"><span class={`n c-${hue(2)}`}>2</span>Video</h2>
      <YouTube id={d.youtube} title={`${d.title}, explained`} />
    </section>

    <div class="prose numbered">
      <Content components={mdxComponents} />
    </div>

    <section aria-labelledby="s-links">
      <h2 id="s-links" class="sec"><span class={`n c-${hue(linksNumber)}`}>{linksNumber}</span>Links</h2>
      <ul class="links">
        {
          d.repo &&
            (d.repoPublic ? (
              <li>
                <a href={d.repo}>GitHub repository</a>
              </li>
            ) : (
              <li class="muted">GitHub repository (private for now)</li>
            ))
        }
        {
          hasLog && (
            <li>
              <a href={url(`/projects/${project.id}/log/`)}>Build log</a>
            </li>
          )
        }
        {
          downloads.map((f) => (
            <li>
              <a href={f.href} download={f.file}>
                {f.label}
              </a>
            </li>
          ))
        }
        {
          d.links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-top: 2rem;
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .head {
    padding-top: 1.5rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
  }
  .draft {
    font: 0.75rem var(--font-mono);
    color: var(--yellow);
  }
  h1 {
    font-size: 2.9rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0.75rem 0 1.25rem;
  }
  .summary {
    background: var(--soft);
    border-left: 3px solid var(--blue);
    border-radius: 0 10px 10px 0;
    padding: 1.25rem 1.5rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .summary .label {
    margin-bottom: 0.5rem;
  }
  .lede {
    font-size: 1.2rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .stats dd {
    font: 600 1.75rem/1.1 var(--font-mono);
    white-space: nowrap;
  }
  .stats dt {
    font: 0.75rem/1.4 var(--font-mono);
    color: var(--muted);
    margin-top: 0.35rem;
  }
  .unit {
    margin-left: 0.25em;
  }
  .measured {
    margin-top: 1rem;
  }
  .sec,
  .prose :global(h2) {
    font-size: 1.75rem;
    line-height: 1.25;
    font-weight: 700;
    margin: 3.25rem 0 1rem;
  }
  .sec .n {
    font: 500 0.875rem var(--font-mono);
    margin-right: 0.7rem;
    vertical-align: 0.3em;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font: 0.95rem var(--font-mono);
  }
  .links .muted {
    color: var(--muted);
  }
  @media (max-width: 720px) {
    h1 {
      font-size: 2.1rem;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .summary {
      padding: 1rem 1.1rem;
    }
  }
</style>
