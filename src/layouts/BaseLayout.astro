---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DotField from '../components/DotField.astro';
import { SITE } from '../site.config';
import { url } from '../lib/utils';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
}

const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.shortName}` : `${SITE.shortName}, electrical engineering`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0b0d10" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Dark by default. Only switch to light if the visitor picked it before.
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-bg focus:px-3 focus:py-2 focus:font-mono focus:text-sm">Skip to content</a>
    <DotField />
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
