---
// A data path drawn as a vertical chain of blocks.
// Usage in MDX:
//   <Pipeline steps={[{ name: 'mii_rx', note: 'Builds bytes, checks CRC', group: 'Receive' }, ...]} />
// `group` is optional. A small label is shown each time the group changes.
interface Step {
  name: string;
  note?: string;
  group?: string;
}
interface Props {
  steps: Step[];
  label?: string;
}
const { steps, label = 'Data path' } = Astro.props;
---

<figure class="pipeline">
  <ol aria-label={label}>
    {
      steps.map((s, i) => (
        <li>
          {s.group && s.group !== steps[i - 1]?.group && <span class="group">{s.group}</span>}
          <div class="block">
            <code>{s.name}</code>
            {s.note && <span>{s.note}</span>}
          </div>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .pipeline {
    margin-block: 1.75rem;
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li + li {
    margin-top: 0.9rem;
  }
  .group {
    display: block;
    font: 500 0.72rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 1.4rem 0 0.5rem;
  }
  li:first-child .group {
    margin-top: 0;
  }
  .block {
    position: relative;
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--soft);
  }
  li + li .block::before {
    content: '';
    position: absolute;
    left: 1.4rem;
    top: -0.95rem;
    height: 0.9rem;
    border-left: 1px solid var(--muted);
  }
  li + li:has(.group) .block::before {
    display: none;
  }
  code {
    font: 600 0.9rem var(--font-mono);
    color: var(--ink);
    background: none;
    border: 0;
    padding: 0;
  }
  .block span {
    font-size: 0.98rem;
  }
  @media (max-width: 640px) {
    .block {
      grid-template-columns: 1fr;
    }
  }
</style>
