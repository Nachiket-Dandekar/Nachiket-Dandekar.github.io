---
// A photo or screenshot with a numbered caption.
// Usage in MDX:
//   import board from './board.jpg';
//   <Figure src={board} alt="What the image shows" caption="Sentence about it." />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Crop tall photos to this max height in px. */
  maxHeight?: number;
  /** Let the figure grow wider than the text column on large screens. */
  wide?: boolean;
}
const { src, alt, caption, maxHeight, wide = false } = Astro.props;
---

<figure class:list={['fig', { wide }]}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200, 1600]}
    sizes={wide ? '(max-width: 1000px) 100vw, 1000px' : '(max-width: 800px) 100vw, 760px'}
    style={maxHeight ? `max-height:${maxHeight}px;object-fit:cover` : undefined}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin-block: 1.75rem;
    counter-increment: figure;
  }
  .fig :global(img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--rule);
    display: block;
  }
  figcaption {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--muted);
    margin-top: 0.6rem;
  }
  figcaption::before {
    content: 'Figure ' counter(figure) '. ';
    font-weight: 600;
    color: var(--ink);
  }
  @media (min-width: 1080px) {
    .wide {
      margin-inline: -6.25rem;
    }
  }
</style>
