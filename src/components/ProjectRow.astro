---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { url, formatDate } from '../lib/utils';
import { topicVar } from '../site.config';

interface Props {
  project: CollectionEntry<'projects'>;
  priority?: boolean;
}
const { project, priority = false } = Astro.props;
const d = project.data;
const head = d.stats[0];
const isTodo = (s?: string) => !!s && s.trim().startsWith('TODO');
---

<a class="row" href={url(`/projects/${project.id}/`)} data-tags={d.tags.join(',')} style={`--tc: ${topicVar(d.tags[0])}`}>
  <div class="thumb">
    {
      d.cover ? (
        <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[320, 480, 720]} sizes="(max-width: 720px) 100vw, 240px" priority={priority} />
      ) : (
        <div class="no-cover" aria-hidden="true">
          <span>photo coming</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <div class="meta">
      {d.tags.map((t) => <Tag tag={t} />)}
      <span class="mono-sm">{formatDate(d.date, 'short')}</span>
      {d.draft && <span class="mono-sm">draft, hidden on the live site</span>}
    </div>
    <h3>
      {d.title} <span class="arrow" aria-hidden="true">&rarr;</span>
    </h3>
    <p class:list={[{ todo: isTodo(d.blurb ?? d.summary) }]}>{d.blurb ?? d.summary}</p>
    {
      d.fix && (
        <p class="fix">
          {d.fix.label}: <span class="c-red">{d.fix.before}</span> <span class="fix-arrow">&rarr;</span>{' '}
          <span class="c-green">{d.fix.after}</span>
        </p>
      )
    }
  </div>
  {
    head && (
      <div class="num">
        <span class:list={['value', { todo: isTodo(head.value) }]}>
          {head.value}
          {head.unit && <span class="unit">{head.unit}</span>}
        </span>
        <small class:list={[{ todo: isTodo(head.label) }]}>{head.label}</small>
      </div>
    )
  }
</a>

<style>
  .row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 240px 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  .row::before {
    content: '';
    position: absolute;
    inset: 0.25rem -1rem;
    z-index: -1;
    border-radius: 12px;
    background: var(--soft);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .row:hover::before,
  .row:focus-visible::before {
    opacity: 1;
  }
  .thumb {
    width: 240px;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    overflow: hidden;
    background: var(--panel);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .no-cover {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font: 0.75rem var(--font-mono);
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-bottom: 0.4rem;
  }
  h3 {
    font-size: 1.6rem;
    line-height: 1.2;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .arrow {
    display: inline-block;
    color: var(--link);
    transition: transform 0.2s;
  }
  .row:hover .arrow {
    transform: translateX(4px);
  }
  p {
    color: var(--muted);
    font-size: 1.05rem;
  }
  .num {
    text-align: right;
    max-width: 12rem;
  }
  .value {
    display: block;
    font: 600 2.5rem/1 var(--font-mono);
    color: var(--ink);
    white-space: nowrap;
  }
  .unit {
    margin-left: 0.3em;
  }
  small {
    display: block;
    margin-top: 0.5rem;
    font: 0.75rem/1.4 var(--font-mono);
    color: var(--muted);
  }
  /* The fix line shows only in the "bold" look. */
  .fix {
    display: none;
    margin-top: 0.4rem;
    font: 500 0.8rem var(--font-mono);
    color: var(--muted);
  }
  .fix-arrow {
    color: var(--muted);
  }
  :global([data-look='bold']) .fix {
    display: block;
  }
  :global([data-look='bold']) .row:hover::before {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--link) 60%, transparent);
  }
  /* "topic" look: the project's topic color on its number and a bar on the left. */
  :global([data-look='topic']) .value {
    color: var(--tc);
  }
  :global([data-look='topic']) .row::after {
    content: '';
    position: absolute;
    left: -0.9rem;
    top: 1.4rem;
    bottom: 1.4rem;
    width: 3px;
    border-radius: 2px;
    background: var(--tc);
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr auto;
      gap: 0.75rem 1rem;
      align-items: start;
    }
    .thumb {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      aspect-ratio: 16 / 9;
    }
    .value {
      font-size: 1.9rem;
    }
    .num {
      max-width: 8.5rem;
    }
    h3 {
      font-size: 1.35rem;
    }
  }
</style>
