---
import { TAG_COLOR, type Tag } from '../site.config';

interface Props {
  tag: Tag;
}
const { tag } = Astro.props;
---

<span class={`tag c-${TAG_COLOR[tag]}`}>{tag}</span>

<style>
  .tag {
    display: inline-block;
    font: 500 0.75rem/1.5 var(--font-mono);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0 0.55rem;
    white-space: nowrap;
  }
</style>
