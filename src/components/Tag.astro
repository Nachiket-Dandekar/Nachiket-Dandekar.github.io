---
import type { Tag } from '../site.config';

interface Props {
  tag: Tag;
}
const { tag } = Astro.props;
---

<span class="tag">{tag}</span>

<style>
  .tag {
    display: inline-block;
    font: 500 0.75rem/1.5 var(--font-mono);
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0 0.55rem;
    white-space: nowrap;
  }
</style>
