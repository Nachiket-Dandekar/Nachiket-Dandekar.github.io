---
// Shows src/assets/profile.jpg (or .jpeg/.png/.webp) if it exists, otherwise an empty slot.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../site.config';

interface Props {
  size?: number;
  class?: string;
}
const { size = 150, class: cls } = Astro.props;
const found = import.meta.glob<{ default: ImageMetadata }>('/src/assets/profile.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(found)[0]?.default;
---

<div class:list={['photo', cls]} style={`--size:${size}px`}>
  {
    photo ? (
      <Image src={photo} alt={`Photo of ${SITE.name}`} width={size} height={size} densities={[1, 2]} priority />
    ) : (
      <span class="empty" aria-hidden="true">
        photo
      </span>
    )
  }
</div>

<style>
  .photo {
    flex: 0 0 var(--size);
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--soft);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .empty {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    border: 1px dashed var(--muted);
    border-radius: 50%;
    font: 0.75rem var(--font-mono);
    color: var(--muted);
  }
</style>
